<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Mister Negative - Orzhov Life Counter</title>
    
    <!-- iOS Web App Meta Tags -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Orzhov Life">
    <meta name="theme-color" content="#050508">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Google Fonts for Old English & Gothic Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&family=Cinzel:wght@700;900&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --orzhov-gold: #e2c069;
            --orzhov-gold-glow: rgba(226, 192, 105, 0.35);
            --orzhov-silver: #d1d5db;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
            -webkit-user-select: none;
            user-select: none;
            touch-action: manipulation;
        }

        body, html {
            width: 100vw;
            height: 100vh;
            height: 100dvh;
            overflow: hidden;
            position: fixed;
            top: 0;
            left: 0;
            background-color: #050508;
            color: #ffffff;
            font-family: 'Inter', -apple-system, sans-serif;
        }

        .font-old-english {
            font-family: 'UnifrakturMaguntia', 'Old English Text MT', 'Texturina', serif;
        }

        .font-cinzel {
            font-family: 'Cinzel', serif;
        }

        /* Fullscreen Frame with Integrated Mister Negative Artwork */
        .orzhov-fullscreen-frame {
            background: 
                radial-gradient(circle at 50% 50%, rgba(13, 14, 22, 0.45) 0%, rgba(5, 5, 9, 0.88) 70%, rgba(3, 3, 5, 0.98) 100%),
                linear-gradient(to bottom, rgba(5, 5, 8, 0.75) 0%, rgba(9, 10, 16, 0.35) 50%, rgba(5, 5, 8, 0.95) 100%),
                url('https://cards.scryfall.io/large/front/0/3/03102434-22d7-464a-a0f5-306c596e36d4.jpg');
            background-size: cover;
            background-position: center 25%;
            background-repeat: no-repeat;
            border: 2px solid transparent;
            border-image: linear-gradient(to bottom, #e2c069 0%, rgba(120, 110, 85, 0.4) 50%, #9ca3af 100%) 1;
            box-shadow: inset 0 0 40px rgba(0, 0, 0, 0.95), 0 0 30px rgba(0, 0, 0, 0.9);
            position: relative;
        }

        /* Inner Filigree Border */
        .orzhov-fullscreen-frame::before {
            content: '';
            position: absolute;
            inset: 6px;
            border: 1px solid rgba(226, 192, 105, 0.25);
            border-radius: 12px;
            pointer-events: none;
        }

        /* Delta Animation */
        @keyframes deltaFade {
            0% { opacity: 1; transform: translate(-50%, -50%) scale(0.9); }
            50% { opacity: 1; transform: translate(-50%, -70%) scale(1.15); }
            100% { opacity: 0; transform: translate(-50%, -90%) scale(1.3); }
        }

        .animate-delta {
            animation: deltaFade 1.1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Gold Metallic Gradient Text */
        .gold-shimmer {
            background: linear-gradient(135deg, #ffffff 0%, #fef08a 25%, #e2c069 60%, #9ca3af 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .life-number {
            font-size: clamp(9rem, 42vh, 24rem);
            line-height: 0.85;
        }

        @media (orientation: landscape) {
            .life-number {
                font-size: clamp(8rem, 58vh, 22rem);
            }
        }
    </style>
</head>
<body id="app-body" class="w-vw h-dvh flex flex-col justify-between select-none relative overflow-hidden bg-black">

    <!-- Full-Screen Card Frame Container -->
    <main class="relative w-full h-full p-1 sm:p-2 flex flex-col justify-center items-center overflow-hidden z-10">
        
        <!-- Floating Delta Indicator -->
        <div id="swing-indicator" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-old-english font-black text-7xl sm:text-8xl pointer-events-none opacity-0 z-40 drop-shadow-[0_4px_15px_rgba(0,0,0,0.95)]"></div>

        <div class="orzhov-fullscreen-frame w-full h-full rounded-xl flex flex-col justify-between items-center relative overflow-hidden">
            
            <!-- Top Header Inside the Frame -->
            <div class="w-full pt-3 px-5 flex justify-between items-center z-30 bg-black/40 backdrop-blur-sm pointer-events-none">
                <div class="flex items-center space-x-2.5">
                    <div class="w-7 h-7 rounded-full bg-gradient-to-br from-amber-100 via-stone-400 to-purple-900 border border-amber-300 flex items-center justify-center shadow-[0_0_10px_rgba(226,192,105,0.4)]">
                        <svg class="w-3.5 h-3.5 text-black fill-current drop-shadow" viewBox="0 0 24 24">
                            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8 0-1.78.58-3.42 1.57-4.75l11.18 11.18C15.42 19.42 13.78 20 12 20zm6.43-3.25L7.25 5.57C8.58 4.58 10.22 4 12 4c4.41 0 8 3.59 8 8 0 1.78-.58 3.42-1.57 4.75z" />
                        </svg>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-old-english text-base text-amber-200 leading-none">Mister Negative</span>
                        <span class="text-[8px] tracking-wider text-stone-400 uppercase font-semibold">Orzhov Syndicate</span>
                    </div>
                </div>

                <div class="pointer-events-auto flex items-center space-x-2">
                    <button onclick="setLife(40)" class="px-2 py-0.5 text-[10px] font-cinzel font-bold rounded bg-amber-500/20 text-amber-200 border border-amber-500/30 active:scale-95 transition-all">
                        Reset 40
                    </button>
                    <button onclick="setLife(20)" class="px-2 py-0.5 text-[10px] font-cinzel font-bold rounded bg-stone-500/20 text-stone-300 border border-stone-400/30 active:scale-95 transition-all">
                        Reset 20
                    </button>
                </div>
            </div>

            <!-- Background Watermarks -->
            <div class="absolute inset-0 flex justify-between items-center px-6 sm:px-16 pointer-events-none opacity-15 z-0">
                <i class="fa-solid fa-skull text-8xl sm:text-9xl text-purple-300"></i>
                <i class="fa-solid fa-sun text-8xl sm:text-9xl text-amber-200"></i>
            </div>

            <!-- Upper Tap / Long-Press Zone (+1 / +5) -->
            <div id="top-tap-zone" class="w-full flex-1 flex items-start justify-center pt-2 z-10 active:bg-amber-300/10 transition-colors cursor-pointer">
                <div class="flex items-center space-x-2 text-amber-200/60 font-old-english text-sm tracking-wide">
                    <i class="fa-solid fa-sun text-amber-300 text-xs"></i>
                    <span>Tap / Hold + Life</span>
                </div>
            </div>

            <!-- Center Old English Life Total Display -->
            <div class="relative w-full flex items-center justify-between px-3 sm:px-10 my-auto z-20 pointer-events-none">
                
                <!-- Left Touch Flank (-) -->
                <div class="pointer-events-auto flex flex-col items-center justify-center p-3 opacity-50 hover:opacity-100 transition-opacity cursor-pointer text-purple-300" onclick="changeLife(-1)">
                    <i class="fa-solid fa-minus text-2xl sm:text-4xl"></i>
                    <span class="text-[10px] font-old-english text-purple-300 mt-1">-1</span>
                </div>

                <!-- Life Total Display -->
                <div class="flex flex-col items-center justify-center text-center">
                    <span id="life-total" class="font-old-english font-black gold-shimmer life-number drop-shadow-[0_15px_35px_rgba(0,0,0,0.98)] transition-transform duration-100">
                        40
                    </span>
                    <span class="text-[10px] sm:text-[12px] font-old-english text-stone-300 tracking-wider -mt-2 sm:-mt-4">
                        Bleed & Gain
                    </span>
                </div>

                <!-- Right Touch Flank (+) -->
                <div class="pointer-events-auto flex flex-col items-center justify-center p-3 opacity-50 hover:opacity-100 transition-opacity cursor-pointer text-amber-300" onclick="changeLife(1)">
                    <i class="fa-solid fa-plus text-2xl sm:text-4xl"></i>
                    <span class="text-[10px] font-old-english text-amber-300 mt-1">+1</span>
                </div>
            </div>

            <!-- Lower Tap / Long-Press Zone (-1 / -5) -->
            <div id="bottom-tap-zone" class="w-full flex-1 flex items-end justify-center pb-3 z-10 active:bg-purple-900/15 transition-colors cursor-pointer">
                <div class="flex items-center space-x-2 text-purple-300/60 font-old-english text-sm tracking-wide">
                    <i class="fa-solid fa-skull text-purple-400 text-xs"></i>
                    <span>Tap / Hold - Life</span>
                </div>
            </div>

        </div>
    </main>

    <script>
        let currentLife = 40;
        let swingAccumulator = 0;
        let swingTimer = null;

        const lifeDisplay = document.getElementById('life-total');
        const swingIndicator = document.getElementById('swing-indicator');

        function triggerHaptic(duration = 15) {
            if (navigator.vibrate) navigator.vibrate(duration);
        }

        function changeLife(delta) {
            currentLife += delta;
            updateLifeDisplay();
            triggerHaptic(delta > 1 || delta < -1 ? 30 : 15);
            accumulateSwing(delta);
        }

        function setLife(amount) {
            currentLife = amount;
            updateLifeDisplay();
            triggerHaptic(40);
        }

        function updateLifeDisplay() {
            lifeDisplay.textContent = currentLife;
            lifeDisplay.classList.add('scale-105');
            setTimeout(() => lifeDisplay.classList.remove('scale-105'), 100);

            if (currentLife <= 0) {
                lifeDisplay.classList.remove('gold-shimmer');
                lifeDisplay.classList.add('text-rose-600');
            } else {
                lifeDisplay.classList.remove('text-rose-600');
                lifeDisplay.classList.add('gold-shimmer');
            }
        }

        function accumulateSwing(delta) {
            swingAccumulator += delta;
            const sign = swingAccumulator > 0 ? '+' : '';
            swingIndicator.textContent = `${sign}${swingAccumulator}`;

            if (swingAccumulator > 0) {
                swingIndicator.className = "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-old-english font-black text-7xl sm:text-8xl pointer-events-none z-40 text-amber-300 animate-delta drop-shadow-[0_0_20px_rgba(252,211,77,0.9)]";
            } else if (swingAccumulator < 0) {
                swingIndicator.className = "absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 font-old-english font-black text-7xl sm:text-8xl pointer-events-none z-40 text-purple-400 animate-delta drop-shadow-[0_0_20px_rgba(192,132,252,0.9)]";
            }

            clearTimeout(swingTimer);
            swingTimer = setTimeout(() => {
                swingAccumulator = 0;
            }, 1000);
        }

        function bindPressAndHold(elementId, deltaSingle, deltaHold) {
            const el = document.getElementById(elementId);
            let holdTimer = null;
            let isHold = false;

            const start = (e) => {
                e.preventDefault();
                isHold = false;
                holdTimer = setTimeout(() => {
                    isHold = true;
                    changeLife(deltaHold);
                }, 400);
            };

            const end = (e) => {
                e.preventDefault();
                clearTimeout(holdTimer);
                if (!isHold) {
                    changeLife(deltaSingle);
                }
            };

            el.addEventListener('touchstart', start, { passive: false });
            el.addEventListener('touchend', end, { passive: false });
            el.addEventListener('mousedown', start);
            el.addEventListener('mouseup', end);
        }

        bindPressAndHold('top-tap-zone', 1, 5);
        bindPressAndHold('bottom-tap-zone', -1, -5);
    </script>
</body>
</html>